{% extends 'base.html.twig' %}

{% block body %}
    <div
        class="hotel-chat"
        data-controller="hotel-chat"
    >
        <h1>Hotel Search</h1>

        <div
            class="hotel-chat__messages"
            data-hotel-chat-target="messages"
        >
            <div class="hotel-chat__message hotel-chat__message--assistant">
                What kind of hotel are you looking for?
            </div>
        </div>

        <form
            action="{{ path('hotel_chat_search') }}"
            method="post"
            data-turbo="false"
            data-hotel-chat-target="form"
            data-action="submit->hotel-chat#submit"
        >
            <label for="hotel-chat-message">
                Search
            </label>

            <input
                id="hotel-chat-message"
                name="message"
                type="text"
                data-hotel-chat-target="input"
                placeholder="e.g. hotels in San Diego with a pool"
            >

            <button
                type="submit"
                data-hotel-chat-target="submit"
            >
                Search
            </button>
        </form>
    </div>
{% endblock %}
